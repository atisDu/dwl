#!/bin/sh
# dunst ignores fractional output scale, so ~/.config/dunst/dunstrc sizes (physical px) work as-is.
# Wayland copy only moves notifications to the top-right corner.
conf=${XDG_RUNTIME_DIR:-/tmp}/dunstrc-wayland
sed -e 's/^\([[:space:]]*origin[[:space:]]*=\).*/\1 top-right/' \
    -e 's/^\([[:space:]]*offset[[:space:]]*=\).*/\1 (12, 56)/' \
    "${XDG_CONFIG_HOME:-$HOME/.config}/dunst/dunstrc" > "$conf"
exec dunst -conf "$conf"
