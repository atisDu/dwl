From 4920c95c35ca761eab4dea1bf3779af0c28ab450 Mon Sep 17 00:00:00 2001
From: Atis Dubrovskis <atis.a.dubrovskis@student.jyu.fi>
Date: Sat, 17 Oct 2026 19:29:36 +0300
Subject: [PATCH 1/2] Highlight the letters matching the input (port of the
 dmenu highlight patch)

---
 menu.c   |  2 ++
 menu.h   |  2 ++
 render.c | 35 ++++++++++++++++++++++++++++++++++-
 3 files changed, 38 insertions(+), 1 deletion(-)

diff --git a/menu.c b/menu.c
index 207d71c..0aa68a1 100644
--- a/menu.c
+++ b/menu.c
@@ -33,6 +33,8 @@ struct menu *menu_create(menu_callback callback) {
 	menu->promptfg = 0xeeeeeeff;
 	menu->selectionbg = 0x005577ff;
 	menu->selectionfg = 0xeeeeeeff;
+	menu->normalhl = 0xf9c74fff;
+	menu->selectionhl = 0xfff2ccff;
 	menu->callback = callback;
 	menu->test_surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, 1, 1);
 	menu->test_cairo = cairo_create(menu->test_surface);
diff --git a/menu.h b/menu.h
index fdd9ad2..4f828f7 100644
--- a/menu.h
+++ b/menu.h
@@ -49,6 +49,8 @@ struct menu {
 	uint32_t promptbg, promptfg;
 	// Selection colors
 	uint32_t selectionbg, selectionfg;
+	// Colors of the letters matching the input, on normal and selected items
+	uint32_t normalhl, selectionhl;
 
 	struct wl_context *context;
 
diff --git a/render.c b/render.c
index e86d93b..a6af063 100644
--- a/render.c
+++ b/render.c
@@ -116,13 +116,45 @@ static void render_cursor(struct menu *menu, cairo_t *cairo) {
 	cairo_fill(cairo);
 }
 
+// Colors in the letters of the item that match the typed input, one highlighted
+// run per space-separated token, on top of the already drawn item.
+static void render_highlights(struct menu *menu, cairo_t *cairo, struct item *item, int x, int y) {
+	char buf[sizeof menu->input];
+	uint32_t color = menu->sel == item ? menu->selectionhl : menu->normalhl;
+
+	strcpy(buf, menu->input);
+	for (char *tok = strtok(buf, " "); tok; tok = strtok(NULL, " ")) {
+		size_t n = strlen(tok);
+		const char *match = NULL;
+		for (const char *s = item->text; *s && !match; s++) {
+			if (!menu->strncmp(s, tok, n)) {
+				match = s;
+			}
+		}
+		if (!match) {
+			continue;
+		}
+		// matched run taken from the item, so it keeps its own casing
+		char *pre = strndup(item->text, match - item->text);
+		char *seg = strndup(match, n);
+		if (pre && seg) {
+			render_text(menu, cairo, seg, x + text_width(cairo, menu->font, pre), y, 0,
+				0, color, menu->padding, 0);
+		}
+		free(pre);
+		free(seg);
+	}
+}
+
 // Renders a single menu item horizontally.
 static int render_horizontal_item(struct menu *menu, cairo_t *cairo, struct item *item, int x) {
 	uint32_t bg_color = menu->sel == item ? menu->selectionbg : menu->normalbg;
 	uint32_t fg_color = menu->sel == item ? menu->selectionfg : menu->normalfg;
 
-	return render_text(menu, cairo, item->text, x, 0, 0,
+	int w = render_text(menu, cairo, item->text, x, 0, 0,
 		bg_color, fg_color, menu->padding, menu->padding);
+	render_highlights(menu, cairo, item, x, 0);
+	return w;
 }
 
 // Renders a single menu item vertically.
@@ -132,6 +164,7 @@ static int render_vertical_item(struct menu *menu, cairo_t *cairo, struct item *
 
 	render_text(menu, cairo, item->text, x, y, menu->width - x,
 		bg_color, fg_color, menu->padding, 0);
+	render_highlights(menu, cairo, item, x, y);
 	return menu->line_height;
 }
 
-- 
2.56.0


From 0ada7ba463aa8f444cb507d31f28bde62347ff99 Mon Sep 17 00:00:00 2001
From: Atis Dubrovskis <atis.a.dubrovskis@student.jyu.fi>
Date: Sat, 17 Oct 2026 19:35:16 +0300
Subject: [PATCH 2/2] Ignore modifier events that arrive before the keymap

wmenu-run segfaulted in xkb_state_update_mask when the compositor sent
modifiers before any keymap (seen in dwl after a virtual keyboard went away).
---
 wayland.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/wayland.c b/wayland.c
index 823ced1..8f8b82d 100644
--- a/wayland.c
+++ b/wayland.c
@@ -321,6 +321,9 @@ static void keyboard_modifiers(void *data, struct wl_keyboard *wl_keyboard,
 		uint32_t mods_latched, uint32_t mods_locked,
 		uint32_t group) {
 	struct keyboard *keyboard = data;
+	if (!keyboard->state) { // modifiers can arrive before any keymap
+		return;
+	}
 	xkb_state_update_mask(keyboard->state, mods_depressed, mods_latched,
 			mods_locked, 0, 0, group);
 }
-- 
2.56.0

